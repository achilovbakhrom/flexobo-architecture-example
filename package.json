{
  "name": "@flexobo-microservice-example/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "mkdir -p node_modules/@flexobo && ln -sf \"$(pwd)/dist/libs/core\" node_modules/@flexobo/core && ln -sf \"$(pwd)/dist/libs/shared-kernel\" node_modules/@flexobo/shared-kernel",
    "start": "npx tsx scripts/dev.ts all",
    "start:users": "npx tsx scripts/dev.ts users",
    "start:chat": "npx tsx scripts/dev.ts chat",
    "start:file": "npx tsx scripts/dev.ts file",
    "start:main": "npx tsx scripts/dev.ts main",
    "start:billing": "npx tsx scripts/dev.ts billing",
    "start:notification": "npx tsx scripts/dev.ts notification",
    "start:telegram": "npx tsx scripts/dev.ts telegram",
    "stop": "npx tsx scripts/dev.ts stop",
    "db:generate:users": "npx prisma generate --config apps/users-service/prisma.config.ts",
    "db:generate:chat": "npx prisma generate --config apps/chat-service/prisma.config.ts",
    "db:generate:file": "npx prisma generate --config apps/file-service/prisma.config.ts",
    "db:generate:main": "npx prisma generate --config apps/main-service/prisma.config.ts",
    "db:generate:billing": "npx prisma generate --config apps/billing-service/prisma.config.ts",
    "db:generate:notification": "npx prisma generate --config apps/notification-service/prisma.config.ts",
    "db:generate:telegram": "npx prisma generate --config apps/telegram-service/prisma.config.ts",
    "db:generate:all": "npm run db:generate:users && npm run db:generate:chat && npm run db:generate:file && npm run db:generate:main && npm run db:generate:billing && npm run db:generate:notification && npm run db:generate:telegram",
    "db:migrate:push:users": "npx prisma db push --config apps/users-service/prisma.config.ts",
    "db:migrate:push:chat": "npx prisma db push --config apps/chat-service/prisma.config.ts",
    "db:migrate:push:file": "npx prisma db push --config apps/file-service/prisma.config.ts",
    "db:migrate:push:main": "npx prisma db push --config apps/main-service/prisma.config.ts",
    "db:migrate:push:billing": "npx prisma db push --config apps/billing-service/prisma.config.ts",
    "db:migrate:push:notification": "npx prisma db push --config apps/notification-service/prisma.config.ts",
    "db:migrate:push:telegram": "npx prisma db push --config apps/telegram-service/prisma.config.ts",
    "db:migrate:push:all": "npm run db:push:users && npm run db:push:chat && npm run db:push:file && npm run db:push:main && npm run db:push:billing && npm run db:push:notification && npm run db:push:telegram",
    "db:migrate:create:users": "npx prisma migrate dev --create-only --config apps/users-service/prisma.config.ts",
    "db:migrate:create:chat": "npx prisma migrate dev --create-only --config apps/chat-service/prisma.config.ts",
    "db:migrate:create:file": "npx prisma migrate dev --create-only --config apps/file-service/prisma.config.ts",
    "db:migrate:create:main": "npx prisma migrate dev --create-only --config apps/main-service/prisma.config.ts",
    "db:migrate:create:billing": "npx prisma migrate dev --create-only --config apps/billing-service/prisma.config.ts",
    "db:migrate:create:notification": "npx prisma migrate dev --create-only --config apps/notification-service/prisma.config.ts",
    "db:migrate:create:telegram": "npx prisma migrate dev --create-only --config apps/telegram-service/prisma.config.ts",
    "db:migrate:deploy:users": "npx prisma migrate deploy --config apps/users-service/prisma.config.ts",
    "db:migrate:deploy:chat": "npx prisma migrate deploy --config apps/chat-service/prisma.config.ts",
    "db:migrate:deploy:file": "npx prisma migrate deploy --config apps/file-service/prisma.config.ts",
    "db:migrate:deploy:main": "npx prisma migrate deploy --config apps/main-service/prisma.config.ts",
    "db:migrate:deploy:billing": "npx prisma migrate deploy --config apps/billing-service/prisma.config.ts",
    "db:migrate:deploy:notification": "npx prisma migrate deploy --config apps/notification-service/prisma.config.ts",
    "db:migrate:deploy:telegram": "npx prisma migrate deploy --config apps/telegram-service/prisma.config.ts",
    "db:migrate:deploy:all": "npm run db:migrate:deploy:users && npm run db:migrate:deploy:chat && npm run db:migrate:deploy:file && npm run db:migrate:deploy:main && npm run db:migrate:deploy:billing && npm run db:migrate:deploy:notification && npm run db:migrate:deploy:telegram",
    "db:studio:users": "npx prisma studio --config apps/users-service/prisma.config.ts --port 5550",
    "db:studio:chat": "npx prisma studio --config apps/chat-service/prisma.config.ts --port 5551",
    "db:studio:file": "npx prisma studio --config apps/file-service/prisma.config.ts --port 5552",
    "db:studio:main": "npx prisma studio --config apps/main-service/prisma.config.ts --port 5553",
    "db:studio:billing": "npx prisma studio --config apps/billing-service/prisma.config.ts --port 5554",
    "db:studio:notification": "npx prisma studio --config apps/notification-service/prisma.config.ts --port 5555",
    "db:studio:telegram": "npx prisma studio --config apps/telegram-service/prisma.config.ts --port 5556",
    "test": "npx nx run-many --target=test --all",
    "test:ci": "npx nx run-many --target=test --all --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "lint": "npx nx run-many --target=lint --all",
    "build": "npx nx run-many --target=build --all",
    "docker:build:users": "docker build -f apps/users-service/Dockerfile -t flexobo/users-service:latest .",
    "docker:build:chat": "docker build -f apps/chat-service/Dockerfile -t flexobo/chat-service:latest .",
    "docker:build:file": "docker build -f apps/file-service/Dockerfile -t flexobo/file-service:latest .",
    "docker:build:main": "docker build -f apps/main-service/Dockerfile -t flexobo/main-service:latest .",
    "docker:build:billing": "docker build -f apps/billing-service/Dockerfile -t flexobo/billing-service:latest .",
    "docker:build:notification": "docker build -f apps/notification-service/Dockerfile -t flexobo/notification-service:latest .",
    "docker:build:telegram": "docker build -f apps/telegram-service/Dockerfile -t flexobo/telegram-service:latest .",
    "docker:build:all": "npm run docker:build:users && npm run docker:build:chat && npm run docker:build:file && npm run docker:build:main && npm run docker:build:billing && npm run docker:build:notification && npm run docker:build:telegram"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
