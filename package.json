    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "stripe": "^20.0.0",
    "table": "^6.8.2",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^13.0.0"
