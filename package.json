{
  "name": "@flexobo-microservice-example/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "mkdir -p node_modules/@flexobo && ln -sf \"$(pwd)/dist/libs/core\" node_modules/@flexobo/core && ln -sf \"$(pwd)/dist/libs/shared-kernel\" node_modules/@flexobo/shared-kernel",
    "start": "npx tsx scripts/dev.ts all",
    "start:order": "npx tsx scripts/dev.ts order",
    "start:gateway": "npx tsx scripts/dev.ts gateway",
    "start:admin": "npx tsx scripts/dev.ts admin",
    "stop": "npx tsx scripts/dev.ts stop",
    "db:migration:create:order": "npx prisma migrate dev --create-only --config apps/order-service/prisma.config.ts",
    "db:migration:create:admin": "npx prisma migrate dev --create-only --config apps/admin-panel/prisma.config.ts",
    "db:migration:create:gateway": "npx prisma migrate dev --create-only --config apps/api-gateway/prisma.config.ts",
    "db:migration:apply:order": "npx prisma migrate deploy --config apps/order-service/prisma.config.ts",
    "db:migration:apply:admin": "npx prisma migrate deploy --config apps/admin-panel/prisma.config.ts",
    "db:migration:apply:gateway": "npx prisma migrate deploy --config apps/api-gateway/prisma.config.ts",
    "db:studio:order": "npx prisma studio --config apps/order-service/prisma.config.ts --port 5555",
    "db:studio:admin": "npx prisma studio --config apps/admin-panel/prisma.config.ts --port 5557",
    "db:studio:gateway": "npx prisma studio --config apps/api-gateway/prisma.config.ts --port 5556",
    "test": "npx nx run-many --target=test --all",
    "test:ci": "npx nx run-many --target=test --all --coverage --coverageReporters=lcov --coverageReporters=text-summary",
    "lint": "npx nx run-many --target=lint --all",
    "build": "npx nx run-many --target=build --all",
    "docker:build:order": "docker build -f apps/order-service/Dockerfile -t flexobo/order-service:latest .",
    "docker:build:gateway": "docker build -f apps/api-gateway/Dockerfile -t flexobo/api-gateway:latest .",
    "docker:build:admin": "docker build -f apps/admin-panel/Dockerfile -t flexobo/admin-panel:latest .",
    "docker:build:all": "npm run docker:build:order && npm run docker:build:gateway && npm run docker:build:admin"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^11.1.9",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@prisma/adapter-pg": "^7.0.1",
    "amqplib": "^0.10.9",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "inquirer": "^8.2.6",
    "ioredis": "^5.8.2",
    "ora": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "table": "^6.8.2",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.1.1",
    "@nx/eslint-plugin": "22.1.1",
    "@nx/jest": "22.1.1",
    "@nx/js": "22.1.1",
    "@nx/nest": "22.1.1",
    "@nx/node": "22.1.1",
    "@nx/web": "22.1.1",
    "@nx/workspace": "22.1.1",
    "@prisma/client": "7.0.1",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nodemon": "^3.1.11",
    "nx": "22.1.0",
    "prettier": "^2.6.2",
    "prisma": "7.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "nx": {
    "includedScripts": []
  }
}
