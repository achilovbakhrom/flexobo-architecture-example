# Server
FILE_SERVICE_PORT=3005
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5438/file_service

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=flexobo-files
AWS_S3_ENDPOINT=  # Optional: for MinIO/LocalStack (e.g., http://localhost:4566)

# File Upload Limits
MAX_FILE_SIZE_MB=50

# JWT (for token validation)
JWT_SECRET=your-secret-key-change-in-production

# Users Service (gRPC for user validation)
USERS_SERVICE_GRPC_URL=localhost:50051
