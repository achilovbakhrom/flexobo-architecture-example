// File Service Database Schema

generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/file-client"
}

datasource db {
    provider = "postgresql"
}

// ============================================================
// Event Sourcing Infrastructure
// ============================================================

// Event Store - stores all domain events
model Event {
    id            String   @id @default(uuid())
    aggregateId   String   @map("aggregate_id")
    aggregateType String   @map("aggregate_type")
    eventType     String   @map("event_type")
    eventData     Json     @map("event_data")
    version       Int
    occurredAt    DateTime @default(now()) @map("occurred_at")
    metadata      Json?

    @@unique([aggregateId, version])
    @@index([aggregateId])
    @@index([aggregateType, occurredAt])
    @@index([eventType])
    @@map("events")
}

// Outbox for reliable event publishing
model OutboxMessage {
    id            String    @id @default(uuid())
    aggregateId   String    @map("aggregate_id")
    aggregateType String    @map("aggregate_type")
    eventType     String    @map("event_type")
    payload       Json
    status        String    @default("PENDING")
    retryCount    Int       @default(0) @map("retry_count")
    maxRetries    Int       @default(5) @map("max_retries")
    createdAt     DateTime  @default(now()) @map("created_at")
    processedAt   DateTime? @map("processed_at")
    publishedAt   DateTime? @map("published_at")
    error         String?
    metadata      Json?

    @@index([status, createdAt])
    @@index([aggregateId])
    @@map("outbox_messages")
}

// Snapshots for aggregate optimization
model Snapshot {
    id            String    @id @default(uuid())
    aggregateId   String    @unique @map("aggregate_id")
    aggregateType String    @map("aggregate_type")
    snapshotData  Json      @map("snapshot_data")
    version       Int
    createdAt     DateTime  @default(now()) @map("created_at")
    expiresAt     DateTime? @map("expires_at")

    @@index([aggregateType])
    @@map("snapshots")
}

// Projection position tracking
model ProjectionPosition {
    id              String   @id @default(uuid())
    projectionName  String   @unique @map("projection_name")
    lastEventId     String   @map("last_event_id")
    lastProcessedAt DateTime @default(now()) @map("last_processed_at")

    @@map("projection_positions")
}

// ============================================================
// Read Models (Projections) - Optimized for Queries
// ============================================================

// File Read Model - denormalized view of files for fast queries
model FileReadModel {
    id           String    @id
    userId       String    @map("user_id")
    companyId    String?   @map("company_id")
    fileName     String    @map("file_name")
    originalName String    @map("original_name")
    mimeType     String    @map("mime_type")
    size         BigInt    // File size in bytes
    s3Key        String    @map("s3_key")
    s3Bucket     String    @map("s3_bucket")
    status       String    @default("ACTIVE") // ACTIVE, DELETED
    uploadedAt   DateTime  @map("uploaded_at")
    version      Int       @default(0)
    lastEventId  String?   @map("last_event_id")
    createdAt    DateTime  @default(now()) @map("created_at")
    updatedAt    DateTime  @updatedAt @map("updated_at")

    @@index([userId])
    @@index([companyId])
    @@index([status])
    @@index([uploadedAt])
    @@index([userId, status])
    @@map("files")
}
