generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/main-service-client"
}

datasource db {
  provider = "postgresql"
}

// ============ EVENT SOURCING ============

model Event {
  id            String   @id @default(uuid())
  aggregateId   String
  aggregateType String   // LOAD, TRIP, BID, BOOKING, TRANSPORT, BOARD
  eventType     String
  payload       Json
  metadata      Json?
  version       Int
  createdAt     DateTime @default(now())

  @@index([aggregateId, aggregateType])
  @@index([eventType])
  @@index([createdAt])
}

model Outbox {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  routingKey  String
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([published, createdAt])
}

// ============ READ MODELS ============

model LoadReadModel {
  id            String   @id
  ownerId       String
  companyId     String
  status        String   // DRAFT, ACTIVE, BOOKED, COMPLETED, CANCELLED

  // Location
  fromCountry   String
  fromCity      String
  fromAddress   String?
  fromLat       Float?
  fromLng       Float?
  toCountry     String
  toCity        String
  toAddress     String?
  toLat         Float?
  toLng         Float?

  // Transport requirements
  transportType String   // TRUCK, VAN, CONTAINER, etc.
  loadingTypes  String[] // TOP, SIDE, REAR

  // Cargo
  cargos        Json     // Array of {name, weight, volume, quantity, packagingType}
  totalWeight   Float
  totalVolume   Float?

  // Features & Requirements
  features       String[] // ADR, TEMP_CONTROL, GPS, etc.
  adrClasses     String[]
  temperatureMin Float?
  temperatureMax Float?

  // Price
  price        Float?
  currency     String  @default("USD")
  paymentTerms String?

  // Dates
  loadingDate     DateTime
  loadingDateTo   DateTime?
  unloadingDate   DateTime?

  // Visibility
  boardIds String[] // Private boards
  isPublic Boolean  @default(true)

  // Metadata
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
  @@index([status])
  @@index([transportType])
  @@index([fromCountry, toCountry])
  @@index([loadingDate])
}

model TripReadModel {
  id        String @id
  ownerId   String
  companyId String
  status    String // DRAFT, ACTIVE, BOOKED, COMPLETED, CANCELLED

  // Embedded Transport snapshot
  transport Json // {id, type, capacity, dimensions, loadingTypes, features, permits}

  // Route points
  loadingPoints   Json // Array of {country, city, address, lat, lng, date, radius}
  unloadingPoints Json // Array of {country, city, address, lat, lng, date, radius}

  // Price
  price        Float?
  currency     String  @default("USD")
  paymentTerms String?

  // Visibility
  boardIds String[]
  isPublic Boolean  @default(true)

  // Metadata
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
  @@index([status])
}

model TransportReadModel {
  id        String @id
  ownerId   String
  companyId String

  // Type & Capacity
  transportType String
  loadingTypes  String[]
  capacityTons  Float
  capacityM3    Float?

  // Dimensions
  lengthM Float?
  widthM  Float?
  heightM Float?

  // Features & Permits
  features   String[] // GPS, TEMP_CONTROL, etc.
  adrClasses String[]
  permits    String[] // TIR, CMR, etc.

  // Status
  isActive Boolean @default(true)

  // Metadata
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
  @@index([transportType])
  @@index([isActive])
}

model BidReadModel {
  id       String @id
  bidderId String
  ownerId  String

  // Polymorphic reference
  postType String // LOAD | TRIP
  postId   String

  // Transport (for bids on loads)
  transportIds String[]

  // Price
  proposedPrice Float
  currency      String @default("USD")

  // Negotiation
  status           String // PENDING, COUNTERED, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  negotiationRound Int    @default(1)

  // Chat integration
  chatRoomId String?

  // Metadata
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([bidderId])
  @@index([ownerId])
  @@index([postType, postId])
  @@index([status])
  @@index([chatRoomId])
}

model NegotiationStepReadModel {
  id       String @id
  bidId    String
  authorId String

  stepNumber Int
  priceOffer Float
  currency   String

  isAccepted Boolean @default(false)
  isRejected Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([bidId])
  @@index([authorId])
}

model BookingReadModel {
  id         String @id
  customerId String // The one who initiated (bidder)
  ownerId    String // Post owner

  // References
  postType String // LOAD | TRIP
  postId   String
  bidId    String

  // Final terms
  finalPrice Float
  currency   String @default("USD")

  // Status
  status String // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, DISPUTED

  // Ratings
  customerRating  Float?
  customerComment String?
  ownerRating     Float?
  ownerComment    String?

  // Metadata
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([customerId])
  @@index([ownerId])
  @@index([postType, postId])
  @@index([bidId])
  @@index([status])
}

model BoardReadModel {
  id        String @id
  ownerId   String
  companyId String

  name        String
  description String?

  // Members (JSON array of {userId, role})
  members Json @default("[]")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
}

// ============ COMPANY READ MODELS ============

model CompanyReadModel {
  id          String   @id
  ownerId     String
  name        String
  type        String   // LOGISTICS, CARRIER, FORWARDER, SHIPPER
  status      String   @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  description String?
  logo        String?
  phone       String?
  email       String?
  address     String?
  country     String?
  city        String?
  taxId       String?  // Tax identification number
  website     String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CompanyMemberReadModel[]

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([country, city])
  @@index([name])
}

model CompanyMemberReadModel {
  id        String   @id
  companyId String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  company CompanyReadModel @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
}

// ============ REFERENCE DATA ============

model Country {
  id        String  @id @default(uuid())
  code      String  @unique // ISO 3166-1 alpha-2: UZ, RU, KZ
  name      String
  nameRu    String?
  nameUz    String?
  phoneCode String  // +998, +7, etc.
  isActive  Boolean @default(true)

  @@index([code])
  @@index([isActive])
}

model Language {
  id       String  @id @default(uuid())
  code     String  @unique // ISO 639-1: uz, ru, en
  name     String
  nativeName String? // O'zbek, Русский, English
  isActive Boolean @default(true)

  @@index([code])
}

model Currency {
  id       String  @id @default(uuid())
  code     String  @unique // ISO 4217: UZS, USD, RUB
  name     String
  symbol   String  // $, ₽, сум
  rate     Float   @default(1) // Exchange rate to USD
  isActive Boolean @default(true)

  @@index([code])
}

model LoadType {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  nameRu      String?
  nameUz      String?
  description String?
  isActive    Boolean @default(true)

  @@index([code])
}

model TransportType {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  nameRu      String?
  nameUz      String?
  description String?
  isActive    Boolean @default(true)

  @@index([code])
}

model LoadingType {
  id          String  @id @default(uuid())
  code        String  @unique // TOP, SIDE, REAR, FULL_OPEN
  name        String
  nameRu      String?
  nameUz      String?
  description String?
  isActive    Boolean @default(true)

  @@index([code])
}

model CompanyType {
  id          String  @id @default(uuid())
  code        String  @unique // LOGISTICS, CARRIER, FORWARDER, SHIPPER
  name        String
  nameRu      String?
  nameUz      String?
  description String?
  isActive    Boolean @default(true)

  @@index([code])
}

model ADRClassification {
  id          String  @id @default(uuid())
  code        String  @unique // 1, 2, 3, 4.1, 4.2, etc.
  name        String
  nameRu      String?
  nameUz      String?
  description String?
  isActive    Boolean @default(true)

  @@index([code])
}

model Permit {
  id          String  @id @default(uuid())
  code        String  @unique // TIR, CMR, EKMT, etc.
  name        String
  nameRu      String?
  nameUz      String?
  description String?
  isActive    Boolean @default(true)

  @@index([code])
}

// ============ SAVED SEARCHES ============

model SavedSearchReadModel {
  id          String   @id
  userId      String
  name        String
  searchType  String   // LOAD, TRIP
  filters     Json     // Search criteria stored as JSON
  notifyOnNew Boolean  @default(false) // Send notification when new matches found
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([searchType])
  @@index([userId, searchType])
}
