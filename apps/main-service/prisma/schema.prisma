generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/main-service-client"
}

datasource db {
  provider = "postgresql"
}

// ============ EVENT SOURCING ============

// Event Store - stores all domain events for Users Service
model Event {
  id            String   @id @default(uuid())
  aggregateId   String   @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  eventType     String   @map("event_type")
  eventData     Json     @map("event_data")
  version       Int
  occurredAt    DateTime @default(now()) @map("occurred_at")
  metadata      Json?

  @@unique([aggregateId, version])
  @@index([aggregateId])
  @@index([aggregateType, occurredAt])
  @@index([eventType])
  @@map("events")
}

// Outbox for reliable event publishing
model OutboxMessage {
  id            String    @id @default(uuid())
  aggregateId   String    @map("aggregate_id")
  aggregateType String    @map("aggregate_type")
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("PENDING")
  retryCount    Int       @default(0) @map("retry_count")
  maxRetries    Int       @default(5) @map("max_retries")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")
  publishedAt   DateTime? @map("published_at")
  error         String?
  metadata      Json?

  @@index([status, createdAt])
  @@index([aggregateId])
  @@map("outbox_messages")
}

// Snapshots for aggregate optimization
model Snapshot {
  id            String    @id @default(uuid())
  aggregateId   String    @unique @map("aggregate_id")
  aggregateType String    @map("aggregate_type")
  snapshotData  Json      @map("snapshot_data")
  version       Int
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime? @map("expires_at")

  @@index([aggregateType])
  @@map("snapshots")
}

// Projection position tracking
model ProjectionPosition {
  id              String   @id @default(uuid())
  projectionName  String   @unique @map("projection_name")
  lastEventId     String   @map("last_event_id")
  lastProcessedAt DateTime @default(now()) @map("last_processed_at")

  @@map("projection_positions")
}

// ============ READ MODELS ============

model LoadReadModel {
  id        String @id
  ownerId   String
  companyId String
  status    String // DRAFT, ACTIVE, BOOKED, COMPLETED, CANCELLED

  // Location
  fromCountry String
  fromCity    String
  fromAddress String?
  fromLat     Float?
  fromLng     Float?
  toCountry   String
  toCity      String
  toAddress   String?
  toLat       Float?
  toLng       Float?

  // Transport requirements
  transportType String // TRUCK, VAN, CONTAINER, etc.
  loadingTypes  String[] // TOP, SIDE, REAR

  // Cargo
  cargos      Json // Array of {name, weight, volume, quantity, packagingType}
  totalWeight Float
  totalVolume Float?

  // Features & Requirements
  features       String[] // ADR, TEMP_CONTROL, GPS, etc.
  adrClasses     String[]
  temperatureMin Float?
  temperatureMax Float?

  // Price
  price        Float?
  currency     String  @default("USD")
  paymentTerms String?

  // Dates
  loadingDate   DateTime
  loadingDateTo DateTime?
  unloadingDate DateTime?

  // Visibility
  boardIds String[] // Private boards
  isPublic Boolean  @default(true)

  // Metadata
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
  @@index([status])
  @@index([transportType])
  @@index([fromCountry, toCountry])
  @@index([loadingDate])
}

model TripReadModel {
  id        String @id
  ownerId   String
  companyId String
  status    String // DRAFT, ACTIVE, BOOKED, COMPLETED, CANCELLED

  // Embedded Transport snapshot
  transport Json // {id, type, capacity, dimensions, loadingTypes, features, permits}

  // Route points
  loadingPoints   Json // Array of {country, city, address, lat, lng, date, radius}
  unloadingPoints Json // Array of {country, city, address, lat, lng, date, radius}

  // Price
  price        Float?
  currency     String  @default("USD")
  paymentTerms String?

  // Visibility
  boardIds String[]
  isPublic Boolean  @default(true)

  // Metadata
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
  @@index([status])
}

model TransportReadModel {
  id        String @id
  ownerId   String
  companyId String

  // Type & Capacity
  transportType String
  loadingTypes  String[]
  capacityTons  Float
  capacityM3    Float?

  // Dimensions
  lengthM Float?
  widthM  Float?
  heightM Float?

  // Features & Permits
  features   String[] // GPS, TEMP_CONTROL, etc.
  adrClasses String[]
  permits    String[] // TIR, CMR, etc.

  // Status
  isActive Boolean @default(true)

  // Metadata
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
  @@index([transportType])
  @@index([isActive])
}

model BidReadModel {
  id       String @id
  bidderId String
  ownerId  String

  // Polymorphic reference
  postType String // LOAD | TRIP
  postId   String

  // Transport (for bids on loads)
  transportIds String[]

  // Price
  proposedPrice Float
  currency      String @default("USD")

  // Negotiation
  status           String // PENDING, COUNTERED, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  negotiationRound Int    @default(1)

  // Chat integration
  chatRoomId String?

  // Metadata
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([bidderId])
  @@index([ownerId])
  @@index([postType, postId])
  @@index([status])
  @@index([chatRoomId])
}

model NegotiationStepReadModel {
  id       String @id
  bidId    String
  authorId String

  stepNumber Int
  priceOffer Float
  currency   String

  isAccepted Boolean @default(false)
  isRejected Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([bidId])
  @@index([authorId])
}

model BookingReadModel {
  id         String @id
  customerId String // The one who initiated (bidder)
  ownerId    String // Post owner

  // References
  postType String // LOAD | TRIP
  postId   String
  bidId    String

  // Final terms
  finalPrice Float
  currency   String @default("USD")

  // Status
  status String // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, DISPUTED

  // Ratings
  customerRating  Float?
  customerComment String?
  ownerRating     Float?
  ownerComment    String?

  // Metadata
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([customerId])
  @@index([ownerId])
  @@index([postType, postId])
  @@index([bidId])
  @@index([status])
}

model BoardReadModel {
  id        String @id
  ownerId   String
  companyId String

  name        String
  description String?

  // Members (JSON array of {userId, role})
  members Json @default("[]")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([companyId])
}

// ============ COMPANY ============

model CompanyReadModel {
  id          String  @id
  ownerId     String
  name        String
  type        String  // LOGISTICS, CARRIER, FORWARDER, BROKER, SHIPPER
  status      String  @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  description String?
  logo        String?
  phone       String?
  email       String?
  address     String?
  country     String?
  city        String?
  taxId       String?
  website     String?

  isActive Boolean @default(true)

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([country, city])
  @@map("companies")
}

model CompanyMemberReadModel {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_members")
}

// ============ SAVED SEARCHES ============

model SavedSearchReadModel {
  id          String  @id
  userId      String
  name        String
  searchType  String  // LOAD, TRIP
  filters     Json    // Search filter criteria
  notifyOnNew Boolean @default(false)
  isActive    Boolean @default(true)
  lastUsedAt  DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([searchType])
  @@index([isActive])
  @@map("saved_searches")
}

// ============ REFERENCE DATA ============

model LanguageReadModel {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("languages")
}

model CountryReadModel {
  id           String  @id @default(uuid())
  code         String  @unique // ISO 3166-1 alpha-2
  name         String
  currencyCode String?
  phoneCode    String?
  isActive     Boolean @default(true)

  @@map("countries")
}

model CurrencyReadModel {
  id       String  @id @default(uuid())
  code     String  @unique // ISO 4217
  name     String
  symbol   String
  rate     Float   @default(1) // Exchange rate to USD
  isActive Boolean @default(true)

  @@map("currencies")
}

model TransportTypeReadModel {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  @@map("transport_types")
}

model LoadTypeReadModel {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  @@map("load_types")
}

model LoadingTypeReadModel {
  id          String  @id @default(uuid())
  name        String  @unique // TOP, SIDE, REAR, FULL
  description String?
  isActive    Boolean @default(true)

  @@map("loading_types")
}

model ADRClassificationReadModel {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  @@map("adr_classifications")
}

model PermitReadModel {
  id          String  @id @default(uuid())
  name        String  @unique // TIR, CMR, EKMT, etc.
  description String?
  isActive    Boolean @default(true)

  @@map("permits")
}
