# ===========================================
# Main Service - Environment Configuration
# ===========================================
# Copy this file to .env and update values for your environment

# ===========================================
# SERVER
# ===========================================
PORT=3001

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# For local development (standalone)
DATABASE_URL=postgresql://postgres:postgres@localhost:5438/main_service

# For Docker Compose
# DATABASE_URL=postgresql://postgres:postgres@postgres-main:5432/main_service

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===========================================
# MESSAGE BROKER (RabbitMQ)
# ===========================================
# For local development (standalone)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# For Docker Compose (shared infrastructure)
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# RabbitMQ Exchange
RABBITMQ_EXCHANGE=flexobo.events
