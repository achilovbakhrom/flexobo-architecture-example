// Chat Service Database Schema

generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/chat-client"
}

datasource db {
    provider = "postgresql"
}

// ============================================================
// Event Sourcing Infrastructure
// ============================================================

// Event Store - stores all domain events for Chat Service
model Event {
    id            String   @id @default(uuid())
    aggregateId   String   @map("aggregate_id")
    aggregateType String   @map("aggregate_type")
    eventType     String   @map("event_type")
    eventData     Json     @map("event_data")
    version       Int
    occurredAt    DateTime @default(now()) @map("occurred_at")
    metadata      Json?

    @@unique([aggregateId, version])
    @@index([aggregateId])
    @@index([aggregateType, occurredAt])
    @@index([eventType])
    @@map("events")
}

// Outbox for reliable event publishing
model OutboxMessage {
    id            String    @id @default(uuid())
    aggregateId   String    @map("aggregate_id")
    aggregateType String    @map("aggregate_type")
    eventType     String    @map("event_type")
    payload       Json
    status        String    @default("PENDING")
    retryCount    Int       @default(0) @map("retry_count")
    maxRetries    Int       @default(5) @map("max_retries")
    createdAt     DateTime  @default(now()) @map("created_at")
    processedAt   DateTime? @map("processed_at")
    publishedAt   DateTime? @map("published_at")
    error         String?
    metadata      Json?

    @@index([status, createdAt])
    @@index([aggregateId])
    @@map("outbox_messages")
}

// Snapshots for aggregate optimization
model Snapshot {
    id            String    @id @default(uuid())
    aggregateId   String    @unique @map("aggregate_id")
    aggregateType String    @map("aggregate_type")
    snapshotData  Json      @map("snapshot_data")
    version       Int
    createdAt     DateTime  @default(now()) @map("created_at")
    expiresAt     DateTime? @map("expires_at")

    @@index([aggregateType])
    @@map("snapshots")
}

// Projection position tracking
model ProjectionPosition {
    id              String   @id @default(uuid())
    projectionName  String   @unique @map("projection_name")
    lastEventId     String   @map("last_event_id")
    lastProcessedAt DateTime @default(now()) @map("last_processed_at")

    @@map("projection_positions")
}

// ============================================================
// Read Models (Projections) - Optimized for Queries
// ============================================================

// Chat Room Read Model
model ChatRoom {
    id                   String    @id @default(uuid())
    participants         String[]  // Array of user IDs
    isGroup              Boolean   @default(false) @map("is_group")
    groupName            String?   @map("group_name")
    isSupportChat        Boolean   @default(false) @map("is_support_chat")
    status               ChatRoomStatus @default(ACTIVE)

    // Unread counts per user as JSON
    unreadCounts         Json      @default("{}") @map("unread_counts")

    // Translation settings per user as JSON
    translationSettings  Json      @default("{}") @map("translation_settings")

    // Last message info
    lastMessageId        String?   @map("last_message_id")
    lastMessagePreview   String?   @map("last_message_preview")
    lastMessageAt        DateTime  @default(now()) @map("last_message_at")

    // Soft delete
    isDeleted            Boolean   @default(false) @map("is_deleted")
    deletedAt            DateTime? @map("deleted_at")

    // Business context (optional, for linking to other entities)
    identifierId         String?   @map("identifier_id")
    identifierType       String?   @map("identifier_type")

    // Event sourcing tracking
    version              Int       @default(0)
    lastEventId          String?   @map("last_event_id")

    createdAt            DateTime  @default(now()) @map("created_at")
    updatedAt            DateTime  @updatedAt @map("updated_at")

    @@index([participants])
    @@index([status, lastMessageAt])
    @@index([isDeleted, lastMessageAt])
    @@index([identifierId])
    @@index([identifierId, identifierType])
    @@map("chat_rooms")
}

enum ChatRoomStatus {
    ACTIVE
    ARCHIVED
    CLOSED
}

// Chat Message model
model ChatMessage {
    id              String        @id @default(uuid())
    roomId          String        @map("room_id")
    senderId        String        @map("sender_id")
    senderType      SenderType    @map("sender_type")
    type            MessageType   @default(TEXT)
    content         String?

    // File attachments
    fileUrls        String[]      @default([]) @map("file_urls")
    fileName        String?       @map("file_name")
    fileMetadata    Json?         @map("file_metadata")

    // Voice message
    voiceDuration   Int?          @map("voice_duration")

    // Message status
    status          MessageStatus @default(SENT)
    isRead          Boolean       @default(false) @map("is_read")
    readAt          DateTime?     @map("read_at")

    // Reply
    replyToId       String?       @map("reply_to_id")

    // Translations (stored as JSON array)
    translations    Json          @default("[]")

    // Edit history (stored as JSON array)
    editHistory     Json          @default("[]") @map("edit_history")

    // Soft delete
    isDeleted       Boolean       @default(false) @map("is_deleted")
    deletedAt       DateTime?     @map("deleted_at")

    // Event sourcing tracking
    version         Int           @default(0)
    lastEventId     String?       @map("last_event_id")

    createdAt       DateTime      @default(now()) @map("created_at")
    updatedAt       DateTime      @updatedAt @map("updated_at")

    @@index([roomId, createdAt])
    @@index([senderId, senderType])
    @@index([isDeleted, createdAt])
    @@map("chat_messages")
}

enum SenderType {
    USER
    ADMIN
    SUPERADMIN
}

enum MessageType {
    TEXT
    IMAGE
    FILE
    VIDEO
    AUDIO
    VOICE
    GIF
    STATUS
}

enum MessageStatus {
    SENT
    DELIVERED
    READ
}

// File metadata for uploaded files
model FileUpload {
    id            String   @id @default(uuid())
    originalName  String   @map("original_name")
    mimeType      String   @map("mime_type")
    size          Int
    storagePath   String   @map("storage_path")
    uploaderId    String   @map("uploader_id")
    createdAt     DateTime @default(now()) @map("created_at")

    @@index([uploaderId])
    @@map("file_uploads")
}

// ============================================================
// Chat History (Audit Log)
// ============================================================

// Chat Room History - audit trail of all room changes
model ChatRoomHistoryReadModel {
    id            String   @id @default(uuid())
    roomId        String   @map("room_id")
    eventType     String   @map("event_type")
    eventData     Json     @map("event_data")
    version       Int      @default(0)
    previousState String?  @map("previous_state")
    newState      String?  @map("new_state")
    changedBy     String?  @map("changed_by")
    occurredAt    DateTime @default(now()) @map("occurred_at")

    @@index([roomId])
    @@index([eventType])
    @@index([occurredAt])
    @@index([roomId, version])
    @@map("chat_room_history")
}

// Chat Message History - audit trail of all message changes
model ChatMessageHistoryReadModel {
    id            String   @id @default(uuid())
    messageId     String   @map("message_id")
    roomId        String   @map("room_id")
    eventType     String   @map("event_type")
    eventData     Json     @map("event_data")
    version       Int      @default(0)
    previousState String?  @map("previous_state")
    newState      String?  @map("new_state")
    changedBy     String?  @map("changed_by")
    occurredAt    DateTime @default(now()) @map("occurred_at")

    @@index([messageId])
    @@index([roomId])
    @@index([eventType])
    @@index([occurredAt])
    @@index([messageId, version])
    @@map("chat_message_history")
}
