// Order Service Database Schema

generator client {
    provider   = "prisma-client-js"
    output     = "../node_modules/.prisma/order-client"
    engineType = "client"
}

datasource db {
    provider = "postgresql"
}

// Event Store - stores all domain events for Order Service
model Event {
    id            String   @id @default(uuid())
    aggregateId   String   @map("aggregate_id")
    aggregateType String   @map("aggregate_type")
    eventType     String   @map("event_type")
    eventData     Json     @map("event_data")
    version       Int
    occurredAt    DateTime @default(now()) @map("occurred_at")
    metadata      Json?

    @@unique([aggregateId, version])
    @@index([aggregateId])
    @@index([aggregateType, occurredAt])
    @@index([eventType])
    @@map("events")
}

// Outbox for reliable event publishing
model OutboxMessage {
    id            String    @id @default(uuid())
    aggregateId   String    @map("aggregate_id")
    aggregateType String    @map("aggregate_type")
    eventType     String    @map("event_type")
    payload       Json
    status        String    @default("PENDING")
    retryCount    Int       @default(0) @map("retry_count")
    maxRetries    Int       @default(5) @map("max_retries")
    createdAt     DateTime  @default(now()) @map("created_at")
    processedAt   DateTime? @map("processed_at")
    publishedAt   DateTime? @map("published_at")
    error         String?
    metadata      Json?

    @@index([status, createdAt])
    @@index([aggregateId])
    @@map("outbox_messages")
}

// Snapshots for aggregate optimization
model Snapshot {
    id            String    @id @default(uuid())
    aggregateId   String    @unique @map("aggregate_id")
    aggregateType String    @map("aggregate_type")
    snapshotData  Json      @map("snapshot_data")
    version       Int
    createdAt     DateTime  @default(now()) @map("created_at")
    expiresAt     DateTime? @map("expires_at")

    @@index([aggregateType])
    @@map("snapshots")
}

// Projection position tracking
model ProjectionPosition {
    id              String   @id @default(uuid())
    projectionName  String   @unique @map("projection_name")
    lastEventId     String   @map("last_event_id")
    lastProcessedAt DateTime @default(now()) @map("last_processed_at")

    @@map("projection_positions")
}

// ============================================================
// Read Models (Projections) - Optimized for Queries
// ============================================================

// Order Read Model - denormalized view of orders for fast queries
model OrderReadModel {
    id             String   @id
    userId         String   @map("user_id")
    status         String   // DRAFT, CONFIRMED, PAID, SHIPPED, DELIVERED, CANCELLED
    totalAmount    Decimal  @map("total_amount") @db.Decimal(10, 2)
    currency       String   @default("USD")
    itemCount      Int      @default(0) @map("item_count")
    trackingNumber String?  @map("tracking_number")
    createdAt      DateTime @default(now()) @map("created_at")
    updatedAt      DateTime @updatedAt @map("updated_at")

    items OrderItemReadModel[]

    @@index([userId])
    @@index([status])
    @@index([createdAt])
    @@map("orders")
}

// Order Item Read Model
model OrderItemReadModel {
    id            String  @id @default(uuid())
    orderId       String  @map("order_id")
    productId     String  @map("product_id")
    productName   String  @map("product_name")
    quantity      Int
    priceAmount   Decimal @map("price_amount") @db.Decimal(10, 2)
    priceCurrency String  @map("price_currency") @default("USD")

    order OrderReadModel @relation(fields: [orderId], references: [id], onDelete: Cascade)

    @@index([orderId])
    @@index([productId])
    @@map("order_items")
}

// ============================================================
// Product Catalog (Reference Data)
// ============================================================

// Product Read Model - product catalog for order items
model ProductReadModel {
    id          String   @id
    sku         String   @unique
    name        String
    description String?
    category    String?
    priceAmount Decimal  @map("price_amount") @db.Decimal(10, 2)
    currency    String   @default("USD")
    stockLevel  Int      @default(0) @map("stock_level")
    isActive    Boolean  @default(true) @map("is_active")
    imageUrl    String?  @map("image_url")
    metadata    Json?
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    @@index([sku])
    @@index([category])
    @@index([isActive])
    @@map("products")
}

// ============================================================
// Payment (Event-Sourced Aggregate)
// ============================================================

// Payment Read Model - denormalized view of payments
model PaymentReadModel {
    id              String    @id
    orderId         String    @map("order_id")
    amount          Decimal   @db.Decimal(10, 2)
    currency        String    @default("USD")
    status          String    // PENDING, PROCESSING, COMPLETED, FAILED, REFUNDED
    paymentMethod   String    @map("payment_method") // CREDIT_CARD, DEBIT_CARD, PAYPAL, BANK_TRANSFER
    transactionId   String?   @map("transaction_id")
    failureReason   String?   @map("failure_reason")
    refundedAmount  Decimal?  @map("refunded_amount") @db.Decimal(10, 2)
    processedAt     DateTime? @map("processed_at")
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")

    @@index([orderId])
    @@index([status])
    @@index([transactionId])
    @@map("payments")
}

// ============================================================
// Order History (Audit Log)
// ============================================================

// Order History - audit trail of all order changes
model OrderHistoryReadModel {
    id          String   @id @default(uuid())
    orderId     String   @map("order_id")
    eventType   String   @map("event_type") // OrderCreated, ItemAdded, OrderConfirmed, etc.
    eventData   Json     @map("event_data")
    previousState String? @map("previous_state") // Status before change
    newState    String?  @map("new_state") // Status after change
    changedBy   String?  @map("changed_by") // User/system that made the change
    ipAddress   String?  @map("ip_address")
    userAgent   String?  @map("user_agent")
    occurredAt  DateTime @default(now()) @map("occurred_at")

    @@index([orderId])
    @@index([eventType])
    @@index([occurredAt])
    @@map("order_history")
}
