# ===========================================
# Order Service - Environment Configuration
# ===========================================
# Copy this file to .env and update values for your environment

# ===========================================
# SERVER
# ===========================================
ORDER_SERVICE_PORT=3000
NODE_ENV=development

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# For local development (standalone)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/order_service

# For Docker Compose
# DATABASE_URL=postgresql://postgres:postgres@postgres-order:5432/order_service

# ===========================================
# CACHE (Redis)
# ===========================================
# For local development (standalone)
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381

# For Docker Compose
# REDIS_HOST=redis-order
# REDIS_PORT=6379
# REDIS_URL=redis://redis-order:6379

# ===========================================
# MESSAGE BROKER (RabbitMQ)
# ===========================================
# For local development (standalone)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# For Docker Compose
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-order-service-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# OPENTELEMETRY (Optional)
# ===========================================
OTEL_SERVICE_NAME=order-service
OTEL_TRACE_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
