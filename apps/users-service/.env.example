# ===========================================
# Users Service - Environment Configuration
# ===========================================
# Copy this file to .env and update values for your environment

# ===========================================
# SERVER
# ===========================================
PORT=3005
GRPC_PORT=50052

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# For local development (standalone)
DATABASE_URL=postgresql://postgres:postgres@localhost:5437/users_service

# For Docker Compose
# DATABASE_URL=postgresql://postgres:postgres@postgres-users:5432/users_service

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===========================================
# MESSAGE BROKER (RabbitMQ)
# ===========================================
# For local development (standalone)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# For Docker Compose
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
