{
  "name": "users-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/users-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/users-service",
        "main": "apps/users-service/src/main.ts",
        "tsConfig": "apps/users-service/tsconfig.app.json",
        "assets": ["apps/users-service/src/assets"]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "sourceMap": false
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "users-service:build",
        "watch": true,
        "inspect": "inspect",
        "port": 9230,
        "debounce": 500,
        "runtimeArgs": ["--enable-source-maps"]
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  },
  "tags": ["scope:users", "type:service"]
}
