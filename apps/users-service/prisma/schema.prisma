// Users Service Database Schema

generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/users-client"
}

datasource db {
    provider = "postgresql"
}

// ============================================================
// Event Sourcing Infrastructure
// ============================================================

// Event Store - stores all domain events for Users Service
model Event {
    id            String   @id @default(uuid())
    aggregateId   String   @map("aggregate_id")
    aggregateType String   @map("aggregate_type")
    eventType     String   @map("event_type")
    eventData     Json     @map("event_data")
    version       Int
    occurredAt    DateTime @default(now()) @map("occurred_at")
    metadata      Json?

    @@unique([aggregateId, version])
    @@index([aggregateId])
    @@index([aggregateType, occurredAt])
    @@index([eventType])
    @@map("events")
}

// Outbox for reliable event publishing
model OutboxMessage {
    id            String    @id @default(uuid())
    aggregateId   String    @map("aggregate_id")
    aggregateType String    @map("aggregate_type")
    eventType     String    @map("event_type")
    payload       Json
    status        String    @default("PENDING")
    retryCount    Int       @default(0) @map("retry_count")
    maxRetries    Int       @default(5) @map("max_retries")
    createdAt     DateTime  @default(now()) @map("created_at")
    processedAt   DateTime? @map("processed_at")
    publishedAt   DateTime? @map("published_at")
    error         String?
    metadata      Json?

    @@index([status, createdAt])
    @@index([aggregateId])
    @@map("outbox_messages")
}

// Snapshots for aggregate optimization
model Snapshot {
    id            String    @id @default(uuid())
    aggregateId   String    @unique @map("aggregate_id")
    aggregateType String    @map("aggregate_type")
    snapshotData  Json      @map("snapshot_data")
    version       Int
    createdAt     DateTime  @default(now()) @map("created_at")
    expiresAt     DateTime? @map("expires_at")

    @@index([aggregateType])
    @@map("snapshots")
}

// Projection position tracking
model ProjectionPosition {
    id              String   @id @default(uuid())
    projectionName  String   @unique @map("projection_name")
    lastEventId     String   @map("last_event_id")
    lastProcessedAt DateTime @default(now()) @map("last_processed_at")

    @@map("projection_positions")
}

// ============================================================
// Read Models (Projections) - Optimized for Queries
// ============================================================

// User Read Model - denormalized view of users for fast queries
model User {
    id                      String        @id @default(uuid())
    uniqueId                String        @unique @map("unique_id")
    email                   String?       @unique
    phoneNumber             String?       @unique @map("phone_number")
    telegramId              String?       @unique @map("telegram_id")
    googleId                String?       @unique @map("google_id")
    passwordHash            String        @map("password_hash")
    fio                     String
    avatar                  String?
    countryId               String?       @map("country_id")
    city                    String?       @map("city")
    role                    UserRole      @default(user)
    userType                UserType?     @map("user_type")
    status                  UserStatus    @default(active)
    language                String        @default("en") @map("user_lang")
    isPrivacyPolicyAccepted Boolean       @default(false) @map("is_privacy_policy_accepted")
    isSubscribedNewsletter  Boolean       @default(false) @map("is_subscribed_newsletter")
    platform                AuthPlatform?
    isVerified              Boolean       @default(false) @map("is_verified")
    lastLoginAt             DateTime?     @map("last_login_at")
    version                 Int           @default(0) // Projection version for idempotency
    lastEventId             String?       @map("last_event_id") // Last processed event ID
    createdAt               DateTime      @default(now()) @map("created_at")
    updatedAt               DateTime      @updatedAt @map("updated_at")

    @@index([email])
    @@index([phoneNumber])
    @@index([telegramId])
    @@index([googleId])
    @@index([uniqueId])
    @@index([role])
    @@index([status])
    @@index([userType])
    @@map("users")
}

enum UserRole {
    user
    admin
    superadmin
}

enum UserStatus {
    active
    inactive
    suspended
    blocked
}

enum UserType {
    broker
    load_owner
    carrier
    company_driver
    owner_operator
}

enum AuthPlatform {
    web
    mobile
    telegram
    google
}

// Refresh Token for JWT refresh
// Note: No FK to User because in event sourcing the read model may not exist yet when tokens are created
model RefreshToken {
    id        String    @id @default(uuid())
    userId    String    @map("user_id")
    token     String    @unique
    jti       String    @unique // JWT ID for blacklisting
    expiresAt DateTime  @map("expires_at")
    revokedAt DateTime? @map("revoked_at")
    createdAt DateTime  @default(now()) @map("created_at")

    @@index([userId])
    @@index([token])
    @@index([jti])
    @@index([expiresAt])
    @@map("refresh_tokens")
}

// Token Blacklist for invalidated JWTs
model TokenBlacklist {
    id            String   @id @default(uuid())
    jti           String   @unique // JWT ID
    expiresAt     DateTime @map("expires_at")
    blacklistedAt DateTime @default(now()) @map("blacklisted_at")
    reason        String?

    @@index([jti])
    @@index([expiresAt])
    @@map("token_blacklist")
}

// OTP for phone/email verification
model OTP {
    id          String     @id @default(uuid())
    code        Int
    codeHash    String     @map("code_hash")
    authMethod  AuthMethod @map("auth_method")
    phoneNumber String?    @map("phone_number")
    email       String?
    expiresAt   DateTime   @map("expires_at")
    verified    Boolean    @default(false)
    createdAt   DateTime   @default(now()) @map("created_at")

    @@index([codeHash])
    @@index([phoneNumber])
    @@index([email])
    @@index([expiresAt])
    @@map("otps")
}

enum AuthMethod {
    PHONE_NUMBER
    EMAIL
}

// ============================================================
// Roles & Permissions
// ============================================================

model Role {
    id          String   @id @default(uuid())
    name        String   @unique
    description String?
    permissions Json     @default("[]") // Array of permission strings
    isSystem    Boolean  @default(false) @map("is_system") // System roles can't be deleted
    isActive    Boolean  @default(true) @map("is_active")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    @@index([name])
    @@index([isActive])
    @@map("roles")
}

model UserRoleMapping {
    id         String   @id @default(uuid())
    userId     String   @map("user_id")
    roleId     String   @map("role_id")
    companyId  String?  @map("company_id") // Role can be scoped to a company
    assignedBy String?  @map("assigned_by")
    assignedAt DateTime @default(now()) @map("assigned_at")

    @@unique([userId, roleId, companyId])
    @@index([userId])
    @@index([roleId])
    @@index([companyId])
    @@map("user_roles")
}

// ============================================================
// User Invitations
// ============================================================

model UserInvitation {
    id         String           @id @default(uuid())
    email      String
    phone      String?
    invitedBy  String           @map("invited_by")
    companyId  String           @map("company_id")
    roleId     String?          @map("role_id")
    token      String           @unique
    status     InvitationStatus @default(PENDING)
    expiresAt  DateTime         @map("expires_at")
    acceptedAt DateTime?        @map("accepted_at")
    acceptedBy String?          @map("accepted_by") // User ID who accepted
    rejectedAt DateTime?        @map("rejected_at")
    createdAt  DateTime         @default(now()) @map("created_at")
    updatedAt  DateTime         @updatedAt @map("updated_at")

    @@index([email])
    @@index([phone])
    @@index([token])
    @@index([companyId])
    @@index([status])
    @@index([expiresAt])
    @@map("user_invitations")
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    REJECTED
    EXPIRED
    REVOKED
}

// ============================================================
// User Company Membership
// ============================================================

model UserCompanyMembership {
    id         String    @id @default(uuid())
    userId     String    @map("user_id")
    companyId  String    @map("company_id")
    memberRole String    @default("MEMBER") @map("member_role") // OWNER, ADMIN, MEMBER
    isActive   Boolean   @default(true) @map("is_active")
    isDefault  Boolean   @default(false) @map("is_default") // User's active/default company
    joinedAt   DateTime  @default(now()) @map("joined_at")
    leftAt     DateTime? @map("left_at")

    @@unique([userId, companyId])
    @@index([userId])
    @@index([companyId])
    @@index([isActive])
    @@index([isDefault])
    @@map("user_company_memberships")
}

// ============================================================
// User History (Audit Log)
// ============================================================

// User History - audit trail of all user changes
model UserHistoryReadModel {
    id            String   @id @default(uuid())
    userId        String   @map("user_id")
    eventType     String   @map("event_type") // UserRegistered, UserLoggedIn, ProfileUpdated, etc.
    eventData     Json     @map("event_data")
    version       Int      @default(0) // Event/aggregate version for synchronization
    previousState String?  @map("previous_state") // Status before change
    newState      String?  @map("new_state") // Status after change
    changedBy     String?  @map("changed_by") // User/system that made the change
    ipAddress     String?  @map("ip_address")
    userAgent     String?  @map("user_agent")
    occurredAt    DateTime @default(now()) @map("occurred_at")

    @@index([userId])
    @@index([eventType])
    @@index([occurredAt])
    @@index([userId, version])
    @@map("user_history")
}
