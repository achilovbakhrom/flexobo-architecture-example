// Users Service Database Schema

generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/users-client"
}

datasource db {
    provider = "postgresql"
}

// User model
model User {
    id                        String       @id @default(uuid())
    uniqueId                  String       @unique @map("unique_id")
    email                     String?      @unique
    phoneNumber               String?      @unique @map("phone_number")
    telegramId                String?      @unique @map("telegram_id")
    passwordHash              String       @map("password_hash")
    fio                       String
    avatar                    String?
    role                      UserRole     @default(USER)
    userType                  UserType?    @map("user_type")
    status                    UserStatus   @default(ACTIVE)
    language                  String       @default("en") @map("user_lang")
    isPrivacyPolicyAccepted   Boolean      @default(false) @map("is_privacy_policy_accepted")
    isSubscribedNewsletter    Boolean      @default(false) @map("is_subscribed_newsletter")
    platform                  AuthPlatform?
    isVerified                Boolean      @default(false) @map("is_verified")
    lastLoginAt               DateTime?    @map("last_login_at")
    createdAt                 DateTime     @default(now()) @map("created_at")
    updatedAt                 DateTime     @updatedAt @map("updated_at")

    refreshTokens RefreshToken[]

    @@index([email])
    @@index([phoneNumber])
    @@index([telegramId])
    @@index([uniqueId])
    @@index([role])
    @@index([status])
    @@index([userType])
    @@map("users")
}

enum UserRole {
    USER
    ADMIN
    SUPERADMIN
}

enum UserStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    BLOCKED
}

enum UserType {
    BROKER
    LOAD_OWNER
    CARRIER
    COMPANY_DRIVER
    OWNER_OPERATOR
}

enum AuthPlatform {
    WEB
    MOBILE
    TELEGRAM
}

// Refresh Token for JWT refresh
model RefreshToken {
    id          String    @id @default(uuid())
    userId      String    @map("user_id")
    token       String    @unique
    jti         String    @unique // JWT ID for blacklisting
    expiresAt   DateTime  @map("expires_at")
    revokedAt   DateTime? @map("revoked_at")
    createdAt   DateTime  @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([token])
    @@index([jti])
    @@index([expiresAt])
    @@map("refresh_tokens")
}

// Token Blacklist for invalidated JWTs
model TokenBlacklist {
    id            String   @id @default(uuid())
    jti           String   @unique // JWT ID
    expiresAt     DateTime @map("expires_at")
    blacklistedAt DateTime @default(now()) @map("blacklisted_at")
    reason        String?

    @@index([jti])
    @@index([expiresAt])
    @@map("token_blacklist")
}
