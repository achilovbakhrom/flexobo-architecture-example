# ===========================================
# API Gateway - Environment Configuration
# ===========================================
# Copy this file to .env and update values for your environment

# ===========================================
# SERVER
# ===========================================
API_GATEWAY_PORT=3001
NODE_ENV=development

# ===========================================
# CORS
# ===========================================
CORS_ORIGIN=*

# ===========================================
# SERVICE URLS (for routing)
# ===========================================
# For local development (standalone)
ORDER_SERVICE_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3002

# For Docker Compose
# ORDER_SERVICE_URL=http://order-service:3000
# ADMIN_PANEL_URL=http://admin-panel:3002

# Self reference
GATEWAY_SERVICE_URL=http://localhost:3001

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-api-gateway-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================================
# CIRCUIT BREAKER
# ===========================================
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://gateway:gateway_password@localhost:5434/gateway_db?schema=public

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# OPENTELEMETRY (Optional)
# ===========================================
OTEL_SERVICE_NAME=api-gateway
OTEL_TRACE_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
