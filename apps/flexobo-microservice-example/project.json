{
  "name": "flexobo-microservice-example",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/flexobo-microservice-example/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/flexobo-microservice-example",
        "main": "apps/flexobo-microservice-example/src/main.ts",
        "tsConfig": "apps/flexobo-microservice-example/tsconfig.app.json",
        "assets": ["apps/flexobo-microservice-example/src/assets"]
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/flexobo-microservice-example/package.json",
        "{workspaceRoot}/dist/apps/flexobo-microservice-example/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/flexobo-microservice-example/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/apps/flexobo-microservice-example/src/main.js"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
