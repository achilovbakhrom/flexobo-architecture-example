# ===========================================
# Admin Panel - Environment Configuration
# ===========================================
# Copy this file to .env and update values for your environment

# ===========================================
# SERVER
# ===========================================
ADMIN_PANEL_PORT=3002
NODE_ENV=development

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# For local development (standalone)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/admin_panel

# For Docker Compose
# DATABASE_URL=postgresql://postgres:postgres@postgres-admin:5432/admin_panel

# ===========================================
# CACHE (Redis)
# ===========================================
# For local development (standalone)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# For Docker Compose
# REDIS_HOST=redis-admin
# REDIS_PORT=6379
# REDIS_URL=redis://redis-admin:6379

# ===========================================
# MESSAGE BROKER (RabbitMQ)
# ===========================================
# For local development (standalone)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# For Docker Compose
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-admin-panel-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# SERVICE URLS
# ===========================================
ORDER_SERVICE_URL=http://localhost:3000
GATEWAY_SERVICE_URL=http://localhost:3001

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug

# ===========================================
# OPENTELEMETRY (Optional)
# ===========================================
OTEL_SERVICE_NAME=admin-panel
OTEL_TRACE_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
