// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Event Store - stores all domain events
model Event {
  id            String   @id @default(uuid())
  aggregateId   String   @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  eventType     String   @map("event_type")
  eventData     Json     @map("event_data")
  version       Int
  occurredAt    DateTime @default(now()) @map("occurred_at")
  metadata      Json?

  @@unique([aggregateId, version])
  @@index([aggregateId])
  @@index([aggregateType, occurredAt])
  @@index([eventType])
  @@map("events")
}

// Outbox for reliable event publishing
model OutboxMessage {
  id            String    @id @default(uuid())
  aggregateId   String    @map("aggregate_id")
  aggregateType String    @map("aggregate_type")
  eventType     String    @map("event_type")
  payload       Json
  status        String    @default("PENDING")
  retryCount    Int       @default(0) @map("retry_count")
  maxRetries    Int       @default(5) @map("max_retries")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")
  publishedAt   DateTime? @map("published_at")
  error         String?
  companyId     String?   @map("company_id")
  metadata      Json?

  @@index([status, createdAt])
  @@index([aggregateId])
  @@index([companyId])
  @@map("outbox_messages")
}

// Snapshots for aggregate optimization
model Snapshot {
  id            String    @id @default(uuid())
  aggregateId   String    @unique @map("aggregate_id")
  aggregateType String    @map("aggregate_type")
  snapshotData  Json      @map("snapshot_data")
  version       Int
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime? @map("expires_at")

  @@index([aggregateType])
  @@map("snapshots")
}

// Saga execution state for orchestration pattern
model Saga {
  id          String    @id @default(uuid())
  sagaType    String    @map("saga_type")
  status      String // PENDING, RUNNING, COMPLETED, FAILED, COMPENSATING, COMPENSATED, COMPENSATION_FAILED
  context     Json
  steps       Json // Array of step executions
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  error       String?
  metadata    Json      @default("{}")

  @@index([sagaType, status])
  @@index([status, startedAt])
  @@map("sagas")
}

// Saga instances for orchestration
model SagaInstance {
  id            String    @id @default(uuid())
  sagaType      String    @map("saga_type")
  status        String // RUNNING, COMPLETED, COMPENSATING, FAILED, TIMED_OUT
  steps         Json // Array of step details
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  compensatedAt DateTime? @map("compensated_at")
  metadata      Json?
  expiresAt     DateTime? @map("expires_at")

  @@index([sagaType, status])
  @@index([status, startedAt])
  @@map("saga_instances")
}

// Two-Phase Commit transactions
model TwoPhaseCommit {
  id            String    @id @default(uuid())
  transactionId String    @unique @map("transaction_id")
  state         String // INIT, PREPARING, PREPARED, COMMITTING, COMMITTED, ABORTING, ABORTED, TIMEOUT
  context       Json
  participants  Json // Array of participant states
  coordinatorId String    @map("coordinator_id")
  startedAt     DateTime  @default(now()) @map("started_at")
  preparedAt    DateTime? @map("prepared_at")
  decidedAt     DateTime? @map("decided_at")
  completedAt   DateTime? @map("completed_at")
  timeout       Int // milliseconds
  metadata      Json?

  @@index([state, startedAt])
  @@index([coordinatorId, state])
  @@map("two_phase_commits")
}

// Distributed transaction log
model TransactionLog {
  id                  String    @id @default(uuid())
  transactionId       String    @unique @map("transaction_id")
  participantServices Json      @map("participant_services") // Array of service names
  status              String // PREPARING, PREPARED, COMMITTED, ABORTED
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  expiresAt           DateTime? @map("expires_at")

  @@index([status])
  @@map("transaction_logs")
}

// Projection position tracking
model ProjectionPosition {
  id              String   @id @default(uuid())
  projectionName  String   @unique @map("projection_name")
  lastEventId     String   @map("last_event_id")
  lastProcessedAt DateTime @default(now()) @map("last_processed_at")

  @@map("projection_positions")
}

// Event partitions metadata
model EventPartition {
  id             String   @id @default(uuid())
  partitionName  String   @unique @map("partition_name")
  aggregateType  String   @map("aggregate_type")
  dateRangeStart DateTime @map("date_range_start")
  dateRangeEnd   DateTime @map("date_range_end")
  rowCount       Int      @default(0) @map("row_count")
  lastUpdated    DateTime @updatedAt @map("last_updated")
  archived       Boolean  @default(false)
  s3Location     String?  @map("s3_location")

  @@index([aggregateType])
  @@map("event_partitions")
}
