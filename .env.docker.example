# Docker Compose Environment Variables
# Copy this to .env for docker-compose.prod.yml

# ============================================
# Order Service Database
# ============================================
POSTGRES_ORDER_USER=postgres
POSTGRES_ORDER_PASSWORD=your_secure_password_here
POSTGRES_ORDER_PORT=5432

# ============================================
# Order Service Redis
# ============================================
REDIS_ORDER_PASSWORD=your_redis_password_here
REDIS_ORDER_PORT=6379

# ============================================
# Admin Panel Database
# ============================================
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=your_secure_password_here
POSTGRES_ADMIN_PORT=5433

# ============================================
# Admin Panel Redis
# ============================================
REDIS_ADMIN_PASSWORD=your_redis_password_here
REDIS_ADMIN_PORT=6380

# ============================================
# RabbitMQ
# ============================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
