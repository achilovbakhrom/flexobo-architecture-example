{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start:order",
      "type": "shell",
      "command": "npm run start:order",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Debugger listening|application successfully started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "services"
      }
    },
