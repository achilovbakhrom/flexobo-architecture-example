{
  "name": "flexobo-microservice-example-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["flexobo-microservice-example"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "e2e/flexobo-microservice-example-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": [
        "flexobo-microservice-example:build",
        "flexobo-microservice-example:serve"
      ]
    }
  }
}
