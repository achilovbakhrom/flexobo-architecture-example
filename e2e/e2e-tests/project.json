{
  "name": "e2e-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "e2e/e2e-tests/src",
  "projectType": "application",
  "tags": ["type:e2e"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "e2e/e2e-tests/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "test": {
      "command": "echo 'E2E tests require running services. Use nx run e2e-tests:e2e instead.'"
    }
  }
}
