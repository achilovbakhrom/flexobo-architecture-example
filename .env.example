# ===========================================
# Flexobo Microservices - Environment Configuration
# ===========================================
# Copy this file to .env and update values for your local environment
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flexobo?schema=public"

# ===========================================
# MESSAGE BROKER (RabbitMQ)
# ===========================================
# AMQP connection URL for event-driven messaging
# Format: amqp://USER:PASSWORD@HOST:PORT
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# ===========================================
# CACHE (Redis)
# ===========================================
# Redis connection details for distributed caching
REDIS_HOST="localhost"
REDIS_PORT=6379
# Optional: REDIS_PASSWORD="" (leave empty for local dev)

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Secret key for JWT token signing (CHANGE IN PRODUCTION!)
JWT_SECRET="your-secret-key-change-in-production"
# Token expiration times
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ===========================================
# SERVICE PORTS
# ===========================================
# Ports for each microservice
ORDER_SERVICE_PORT=3000
API_GATEWAY_PORT=3001
ADMIN_PANEL_PORT=3002

# ===========================================
# SERVICE URLS (for inter-service communication)
# ===========================================
# These are used when services need to call each other
ORDER_SERVICE_URL="http://localhost:3000"
API_GATEWAY_URL="http://localhost:3001"
ADMIN_PANEL_URL="http://localhost:3002"

# ===========================================
# OBSERVABILITY (Optional)
# ===========================================
# Jaeger for distributed tracing
JAEGER_ENDPOINT="http://localhost:14268/api/traces"
JAEGER_SERVICE_NAME="flexobo-services"

# ===========================================
# ENVIRONMENT
# ===========================================
# Application environment (development, staging, production)
NODE_ENV="development"

# ===========================================
# LOGGING
# ===========================================
# Log level (error, warn, info, debug, verbose)
LOG_LEVEL="debug"

# ===========================================
# CIRCUIT BREAKER
# ===========================================
# Circuit breaker configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# ===========================================
# RATE LIMITING
# ===========================================
# API rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
